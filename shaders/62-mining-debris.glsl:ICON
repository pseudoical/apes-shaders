#ifdef FRAGMENT
in vec3 v_world_pos;
in vec3 v_face_normal;
in vec3 v_object_pos;
in vec3 v_object_normal;
#ifdef INSTANCED
flat in float v_material_code;
#endif
uint baseMaterialCode(uint code) {
vec4 codes=texelFetch(u_variant_codes,ivec2(int(code>>2u),0),0);
return uint(floor(codes[int(code&3u)]*255.0+0.5));
}
void applyMaterialVariant(uint code,inout vec4 color,inout vec4 data) {
color*=texelFetch(u_variants,ivec2(0,int(code)),0);
color+=texelFetch(u_variants,ivec2(1,int(code)),0);
data*=texelFetch(u_variants,ivec2(2,int(code)),0);
data+=texelFetch(u_variants,ivec2(3,int(code)),0);
}
vec4 debrisMaterial(out vec4 data) {
#ifdef INSTANCED
uint code=uint(max(v_material_code+0.5,0.0));
#else
uint code=uint(max(u_material_code,0));
#endif
uint base_code=baseMaterialCode(code);
ivec2 atlas_size=textureSize(u_atlas,0);
ivec2 material_size=atlas_size/ivec2(16,4);
ivec2 material_origin=ivec2(int(base_code%16u),int(base_code/16u))*material_size;
vec3 n=abs(v_object_normal);
vec2 face_pos;
int tile;
if(n.x>=n.y && n.x>=n.z){ face_pos=v_object_pos.yz; tile=4; }
else if(n.y>=n.z){ face_pos=v_object_pos.xz; tile=1; }
else { face_pos=v_object_pos.xy; tile=0; }
#ifdef TILED
vec2 wrapped=fract(face_pos*u_texel_density/64.0)*64.0;
ivec2 pixel=clamp(ivec2(floor(wrapped)),ivec2(0),ivec2(63));
ivec2 texel=material_origin+ivec2(0,tile*64)+pixel;
vec4 color=texelFetch(u_atlas,texel,0);
float grain=fract(sin(dot(vec2(texel),vec2(12.9898,78.233)))*43758.5453);
color.rgb*=1.0-0.5*u_texel_grain+u_texel_grain*grain;
#else
ivec2 pixel=ivec2(floor((face_pos+vec2(1.0))*4.0));
pixel=clamp(pixel,ivec2(0),ivec2(7));
ivec2 texel=material_origin+ivec2(24,tile*64+24)+pixel;
vec4 color=texelFetch(u_atlas,texel,0);
#endif
data=vec4(0.85,0.0,0.0,1.0);
applyMaterialVariant(code,color,data);
return color;
}
vec3 renderedFaceNormal() {
vec3 normal=cross(dFdx(v_world_pos),dFdy(v_world_pos));
float length_squared=dot(normal,normal);
if(length_squared<1e-12){
return normalize(v_face_normal);
}
normal*=inversesqrt(length_squared);
return dot(normal,v_face_normal)<0.0 ? -normal : normal;
}
void main() {
#ifdef ICON
vec3 color;
if(u_icon_emissive.a>0.5){
color=u_icon_emissive.rgb;
} else {
vec4 material_data;
vec4 material=debrisMaterial(material_data);
vec3 normal=renderedFaceNormal();
float diffuse=max(dot(normal,normalize(u_icon_light)),0.0);
float rim=0.5+0.5*normal.y;
color=material.rgb*(u_icon_ambient+0.62*diffuse+0.12*rim);
}
o_color=vec4(color,1.0);
#else
vec4 material_data;
vec4 material=debrisMaterial(material_data);
write_gbuffer(material.rgb,renderedFaceNormal(),material_data);
#endif
}
