#ifdef VERTEX
in vec3 a_position;
in vec3 a_normal;
in vec2 a_uv;
#ifdef INSTANCED
in mat4 a_instance_model;
in vec4 a_instance_data;
flat out vec4 v_color;
#endif
out vec3 v_normal;
out float v_along;
void main() {
#ifdef INSTANCED
mat4 model = a_instance_model;
mat4 mvp = u_vp * a_instance_model;
v_color = a_instance_data;
#else
mat4 model = u_model;
mat4 mvp = u_mvp;
#endif
vec4 position = vec4(a_position, 1.0);
vec3 normal = a_normal;
#ifdef DUAL_QUAT_SKINNING
vec3 tangent = vec3(1.0, 0.0, 0.0);
apply_bone_transform(position, normal, tangent);
v_along = 1.0 - a_uv.y;
#else
v_along = a_position.z;
#endif
v_normal = normalize(transpose(inverse(mat3(model))) * normal);
gl_Position = mvp * position;
}
#endif
#ifdef FRAGMENT
in vec3 v_normal;
in float v_along;
#ifdef INSTANCED
flat in vec4 v_color;
#endif
void main() {
#ifdef INSTANCED
vec4 color = v_color;
#else
vec4 color = u_color;
#endif
vec3 rgb = color.rgb * (1.0 - 0.10 * (1.0 - v_along) * color.a);
vec3 normal = normalize(v_normal);
if (!gl_FrontFacing) {
normal = -normal;
}
#ifdef OVERLAY
vec3 key = normalize(vec3(0.35, -0.75, 0.55));
float diffuse = max(dot(normal, key), 0.0);
float rim = 0.5 + 0.5 * normal.z;
vec3 lit = rgb * (0.30 + 0.85 * diffuse + 0.15 * rim);
o_color = vec4(texture(u_lut, mix(vec3(0.5 / 32.0), vec3(31.5 / 32.0), clamp(lit, 0.0, 1.0))).rgb, 1.0);
#else
write_gbuffer(rgb, normal, vec4(0.4, 0.0, 0.0, 0.85));
#endif
}
