#define INSTANCED

//! bundle game
//! queue debug
//! blend one one_minus_src_alpha
//! zwrite off
//! ztest on
//! cull off

precision highp float;
uniform mat4 u_mvp;
uniform mat4 u_vp;
uniform mat4 u_projection;
uniform vec2 u_screenDims;
uniform vec3 u_cam_pos;
uniform vec4 u_color;
uniform vec4 u_trail_shape;
uniform vec2 u_fade_in;
#ifdef VERTEX
in vec3 a_position;
#ifdef INSTANCED
in mat4 a_instance_model;
#endif
out float v_across;
out float v_alpha;
flat out vec3 v_color;
void main() {
#ifdef INSTANCED
vec3 p0 = a_instance_model[0].xyz;
vec3 p1 = a_instance_model[1].xyz;
float along = a_position.y * 0.5 + 0.5;
float age = clamp(mix(a_instance_model[0].w, a_instance_model[1].w, along), 0.0, 1.0);
vec3 pos = mix(p0, p1, along);
vec3 dir = p1 - p0;
float len = length(dir);
dir = len > 1.0e-5 ? dir / len : vec3(0.0, 0.0, 1.0);
vec3 to_cam = u_cam_pos - pos;
vec3 side = cross(dir, to_cam);
if (dot(side, side) < 1.0e-8 * max(dot(to_cam, to_cam), 1.0)) {
side = cross(dir, abs(dir.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0));
}
side = normalize(side);
float view_depth = max((u_vp * vec4(pos, 1.0)).w, 0.0);
float pixel_m = 2.0 * view_depth / max(u_projection[1][1] * u_screenDims.y, 1.0);
float widen = a_instance_model[3].x > 0.0 ? a_instance_model[3].x : 1.0;
float width = max(u_trail_shape.x * widen * mix(1.0, u_trail_shape.y, age), u_trail_shape.z * pixel_m);
gl_Position = u_vp * vec4(pos + side * (a_position.x * 0.5 * width), 1.0);
float fresh = 1.0 - age;
float fade_in = smoothstep(u_fade_in.x, u_fade_in.y, length(to_cam));
v_alpha = a_instance_model[2].w * fresh * fresh * (3.0 - 2.0 * fresh) * fade_in;
v_color = a_instance_model[2].rgb;
#else
gl_Position = u_mvp * vec4(a_position, 1.0);
v_alpha = u_color.a;
v_color = u_color.rgb;
#endif
v_across = a_position.x;
}
#endif
#ifdef FRAGMENT
in float v_across;
in float v_alpha;
flat in vec3 v_color;
out vec4 o_color;
void main() {
float s = abs(v_across);
float alpha = v_alpha * (1.0 - s * s);
float middle = 1.0 - smoothstep(0.0, 0.4, s);
o_color = vec4(v_color * (alpha + v_alpha * middle * u_trail_shape.w), alpha);
}
#endif